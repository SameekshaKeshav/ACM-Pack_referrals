# Copy to `.env` in the project root:  cp .env.example .env
# Never commit `.env` (it is gitignored).

# Required — Django secret; generate a new value for any shared/staging/prod environment.
SECRET_KEY=dev-only-change-me-before-deploy

# Local development
DEBUG=True

# SQLite file location. Leave unset locally (uses db.sqlite3 in the project root).
# Staging sets this to /data/db.sqlite3 so the database lives on the Railway volume.
# SQLITE_PATH=

# Origins trusted for CSRF-protected form POSTs (e.g. the admin login). Leave unset locally.
# Staging sets this to https://acm-packreferrals-production.up.railway.app.
# Include the scheme (https://). Separate multiple origins with commas.
# CSRF_TRUSTED_ORIGINS=

# Request log level (JSON lines on stdout). WARNING hides per-request lines.
# LOG_LEVEL=INFO

# Sentry error tracking. Leave SENTRY_DSN unset locally so nothing is reported.
# Staging sets SENTRY_DSN from the Sentry project and SENTRY_ENVIRONMENT=staging.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=

# React (or other) frontend origin — used for links in emails (auth, etc.)
FRONTEND_URL=http://localhost:3000

# Email. Leave EMAIL_BACKEND unset to print mail (including verification codes)
# to the console. Staging sends through Brevo's HTTPS API with:
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# BREVO_API_KEY=

# Auth (BE1) — all optional; the defaults below are what the code uses.
# ALLOWED_SIGNUP_EMAIL_DOMAIN=ncsu.edu
# VERIFICATION_CODE_TTL_MINUTES=10
# ACCESS_TOKEN_LIFETIME_HOURS=24
# REFRESH_TOKEN_LIFETIME_DAYS=7
# DEFAULT_FROM_EMAIL=no-reply@packreferrals.ncsu.edu
# THROTTLE_CODE_REQUEST=5/15min
# THROTTLE_VERIFY_ATTEMPT=10/15min
# VERIFICATION_MAX_ATTEMPTS=5
